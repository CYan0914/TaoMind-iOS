    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>com.cyan0914.taomind.referral</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>taomind</string>
            </array>
        </dict>
    </array>
