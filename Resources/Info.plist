    <string>TaoMind uses the microphone so you can speak your question instead of typing.</string>
    <key>NSSpeechRecognitionUsageDescription</key>
    <string>TaoMind uses speech recognition to turn your spoken question into text.</string>
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <false/>
        <key>NSExceptionDomains</key>
        <dict>
            <key>observant-prosperity-production-92d3.up.railway.app</key>
            <dict>
                <key>NSExceptionAllowsInsecureHTTPLoads</key>
                <true/>
            </dict>
        </dict>
